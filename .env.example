# Copy to .env and fill in. The .env file is gitignored.

# API key. For local servers (LMStudio / llama.cpp / Ollama) any non-empty dummy value works.
OPENAI_API_KEY=sk-replace-me

# Endpoint. Read from here, not the YAML config. Point it at your provider or server:
#   OpenAI    : https://api.openai.com/v1
#   AI Studio : https://generativelanguage.googleapis.com/v1beta/openai/
#   llama.cpp : http://localhost:8080/v1
OPENAI_BASE_URL=http://localhost:1234/v1
# Gemini judge credentials.
GEMINI_API_KEY=gemini-replace-me

# Endpoint. Native Google GenAI route used by the secondary judge.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com

# Rewriter model credentials (separate from judge). Points to xAI/Grok or any other provider.
REWRITER_API_KEY=xai-replace-me
REWRITER_BASE_URL=https://api.x.ai/v1
